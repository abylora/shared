    {
      "id": "11c-a-failed-delta-apply-resets-the-cursor",
      "description": "A Delta whose apply fails resets the cursor to 0 and closes the stream; the held set is still the last one applied successfully.",
      "own_public_key": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "initial": {
        "cursor": "33000",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "steps": [
        {
          "hello": {
            "held_version": "33000"
          }
        },
        {
          "receive": {
            "delta": {
              "from_version": "33000",
              "to_version": "33060",
              "ops": [
                {
                  "upsert": {
                    "entry": {
                      "public_key": "2222222222222222222222222222222222222222222222222222222222222222",
                      "tunnel_ip": "0a400103",
                      "tunnel_ip6": "",
                      "valid_until": "1798761600"
                    }
                  }
                }
              ]
            }
          },
          "apply_succeeds": false,
          "expect": {
            "outcome": "apply_failed"
          }
        },
        {
          "hello": {
            "held_version": "0"
          }
        }
      ],
      "final": {
        "cursor": "0",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      }
    },
