  "cases": [
    {
      "id": "02-a-delta-from-ahead-of-the-cursor-is-a-gap",
      "description": "A Delta whose from_version is above the cursor closes the stream and keeps the cursor and set.",
      "own_public_key": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "initial": {
        "cursor": "7300",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "steps": [
        {
          "hello": {
            "held_version": "7300"
          }
        },
        {
          "receive": {
            "delta": {
              "from_version": "7360",
              "to_version": "7420",
              "ops": [
                {
                  "upsert": {
                    "entry": {
                      "public_key": "2222222222222222222222222222222222222222222222222222222222222222",
                      "tunnel_ip": "0a400103",
                      "tunnel_ip6": "",
                      "valid_until": "1798761600"
                    }
                  }
                }
              ]
            }
          },
          "expect": {
            "outcome": "violation",
            "violation": "delta_gap"
          }
        },
        {
          "hello": {
            "held_version": "7300"
          }
        }
      ],
      "final": {
        "cursor": "7300",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ],
        "skipped": "0"
      }
    },
