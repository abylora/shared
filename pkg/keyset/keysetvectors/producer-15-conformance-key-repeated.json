{
  "schema": "abylora.keyset.vectors.v1",
  "kind": "producer.conformance",
  "rules": [
    "9",
    "10",
    "13"
  ],
  "cases": [
    {
      "id": "15-one-op-per-key-conforms",
      "description": "One Upsert moving the key conforms.",
      "old": {
        "version": "40000",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "new": {
        "version": "40060",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400103",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "delta": {
        "from_version": "40000",
        "to_version": "40060",
        "ops": [
          {
            "upsert": {
              "entry": {
                "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
                "tunnel_ip": "0a400103",
                "tunnel_ip6": "",
                "valid_until": "1798761600"
              }
            }
          }
        ]
      },
      "expect": {
        "conforms": true
      }
    },
    {
      "id": "15-a-delta-that-misses-a-change-fails",
