{
  "schema": "abylora.keyset.vectors.v1",
  "kind": "producer.conformance",
  "rules": [
    "10",
    "11",
    "12"
  ],
  "cases": [
    {
      "id": "16-remove-before-upsert-reusing-a-freed-address-conforms",
      "description": "The only conforming emission: Remove(old) before Upsert(new) in one Delta.",
      "old": {
        "version": "50500",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "new": {
        "version": "50560",
        "set": [
          {
            "public_key": "2222222222222222222222222222222222222222222222222222222222222222",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "delta": {
        "from_version": "50500",
        "to_version": "50560",
        "ops": [
          {
            "remove": {
              "public_key": "1111111111111111111111111111111111111111111111111111111111111111"
            }
          },
          {
            "upsert": {
              "entry": {
                "public_key": "2222222222222222222222222222222222222222222222222222222222222222",
                "tunnel_ip": "0a400102",
                "tunnel_ip6": "",
                "valid_until": "1798761600"
              }
            }
          }
        ]
      },
      "expect": {
        "conforms": true
      }
    },
    {
      "id": "16-upsert-before-remove-reusing-a-freed-address-fails",
      "description": "Upsert(new) before Remove(old) does not conform.",
      "old": {
        "version": "50500",
        "set": [
          {
            "public_key": "1111111111111111111111111111111111111111111111111111111111111111",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "new": {
        "version": "50560",
        "set": [
          {
            "public_key": "2222222222222222222222222222222222222222222222222222222222222222",
            "tunnel_ip": "0a400102",
            "tunnel_ip6": "",
            "valid_until": "1798761600"
          }
        ]
      },
      "delta": {
        "from_version": "50500",
        "to_version": "50560",
        "ops": [
          {
            "upsert": {
              "entry": {
                "public_key": "2222222222222222222222222222222222222222222222222222222222222222",
                "tunnel_ip": "0a400102",
                "tunnel_ip6": "",
                "valid_until": "1798761600"
              }
            }
          },
          {
            "remove": {
              "public_key": "1111111111111111111111111111111111111111111111111111111111111111"
            }
          }
        ]
      },
      "expect": {
        "conforms": false,
        "failure": "upsert_before_remove"
      }
    },
